{
	"name": "dsh-dynamic-wallpaper",
	"version": "0.1.0",
	"description": "Animated wallpaper plugin for DeepSeek Harness: 7 built-in canvas backgrounds (particles, meteor shower, starfield, waves, rain, bubbles, matrix) plus custom video import, with speed/density/opacity/blur controls and durable localStorage persistence",
	"license": "MIT",
	"author": "Willmylife",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Willmylife/dsh-dynamic-wallpaper.git"
	},
	"keywords": [
		"deepseek-harness",
		"dsh",
		"plugin",
		"dsh-plugin",
		"wallpaper",
		"dynamic-wallpaper",
		"animated-background",
		"web-ui"
	],
	"type": "module",
	"main": "lib/index.js",
	"scripts": {
		"test": "node test-draw.cjs",
		"check": "node --check lib/client.js"
	},
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./package.json": "./package.json"
	},
	"files": [
		"lib/index.js",
		"lib/client.js",
		"cordis.patch.yml"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"inject": [
				"@deepseek-ai/dsh-client-runtime",
				"@deepseek-ai/dsh-client-locale",
				"@deepseek-ai/dsh-client-ui-theme"
			],
			"platform": "web",
			"immediately": true
		}
	},
	"peerDependencies": {
		"react": "^18.2.0",
		"@deepseek-ai/cordis": "^4.0.1",
		"@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
		"@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.6",
		"@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
		"@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6"
	}
}
